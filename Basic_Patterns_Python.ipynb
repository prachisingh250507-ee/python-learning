      "source": [
        "# Print cubes from 1 to N.\n",
        "num = int(input(\"Enter the number upto which you want to print cubes :\"))\n",
        "for i in range (1,num+1) :\n",
        "  cube = i*i*i\n",
        "  print(f\"{cube}\")"
      ],
